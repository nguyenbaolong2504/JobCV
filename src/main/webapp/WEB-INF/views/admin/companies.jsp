<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Quản trị doanh nghiệp | RecruitFlow"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="app-layout"><jsp:include page="/WEB-INF/views/common/admin-sidebar.jsp"/><main class="app-main bg-light"><div class="topbar"><div><p class="text-muted small mb-1">Đối tác tuyển dụng</p><h1 class="h4 mb-0">Doanh nghiệp</h1></div><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/admin/users?role=HR"><i class="bi bi-person-check me-1"></i>Duyệt nhà tuyển dụng</a></div><div class="main-content"><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if>
<section class="card mb-4"><div class="card-body"><form class="row g-3 align-items-end" action="${pageContext.request.contextPath}/admin/companies" method="get"><div class="col-lg-7"><label class="form-label" for="adminCompanyKeyword">Tìm doanh nghiệp</label><input class="form-control" id="adminCompanyKeyword" name="keyword" maxlength="100" value="<c:out value='${param.keyword}'/>" placeholder="Tên, lĩnh vực hoặc địa chỉ"></div><div class="col-lg-5 d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Tìm kiếm</button><a class="btn btn-light" href="${pageContext.request.contextPath}/admin/companies">Xóa lọc</a></div></form></div></section>
<div class="admin-company-grid"><c:forEach var="company" items="${companies}"><article class="admin-company-card"><div class="admin-company-card-head"><span><c:choose><c:when test="${company.accountStatus eq 'ACTIVE'}"><img src="${pageContext.request.contextPath}/companies/media?id=${company.id}&type=logo" alt="Logo ${company.name}"></c:when><c:otherwise><i class="bi bi-building text-muted"></i></c:otherwise></c:choose></span><div><h2><c:out value="${company.name}"/></h2><p><c:out value="${empty company.industry ? 'Chưa cập nhật lĩnh vực' : company.industry}"/></p></div><b class="status-badge status-${company.accountStatus}"><c:out value="${company.accountStatus}"/></b></div><dl><div><dt>Chủ tài khoản</dt><dd><c:out value="${company.ownerName}"/><small><c:out value="${company.ownerEmail}"/></small></dd></div><div><dt>Tin đang tuyển</dt><dd><strong><c:out value="${company.openJobs}"/></strong></dd></div><div><dt>Xác thực</dt><dd>${company.verified ? 'Đã xác thực' : 'Chờ xác thực'}</dd></div></dl><div class="admin-company-actions"><c:if test="${company.accountStatus eq 'ACTIVE' and not empty company.description}"><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/companies/detail?id=${company.id}">Trang công khai</a></c:if><a class="btn btn-sm btn-light" href="${pageContext.request.contextPath}/admin/users?keyword=${company.ownerEmail}">Quản lý tài khoản</a><form action="${pageContext.request.contextPath}/admin/companies" method="post"><input type="hidden" name="_csrf" value="<c:out value='${requestScope.csrfToken}'/>"><input type="hidden" name="companyId" value="${company.id}"><input type="hidden" name="verified" value="${not company.verified}"><button class="btn btn-sm ${company.verified ? 'btn-outline-danger' : 'btn-success'}" type="submit" ${empty company.description and not company.verified ? 'disabled' : ''}><i class="bi ${company.verified ? 'bi-patch-minus' : 'bi-patch-check'} me-1"></i>${company.verified ? 'Thu hồi xác thực' : 'Xác thực'}</button></form></div></article></c:forEach><c:if test="${empty companies}"><div class="rf-card empty-state"><div class="empty-icon"><i class="bi bi-building-x"></i></div><h2 class="h5">Không có doanh nghiệp phù hợp</h2><p>Hồ sơ nhà tuyển dụng sẽ xuất hiện tại đây sau khi đăng ký.</p></div></c:if></div><jsp:include page="/WEB-INF/views/common/pagination.jsp"/>
</div></main></div><jsp:include page="/WEB-INF/views/common/footer.jsp"/>

<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Quản trị tin tuyển dụng | RecruitFlow"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="app-layout"><jsp:include page="/WEB-INF/views/common/admin-sidebar.jsp"/><main class="app-main bg-light"><div class="topbar"><div><p class="text-muted small mb-1">Vận hành nền tảng</p><h1 class="h4 mb-0">Tin tuyển dụng</h1></div><span class="platform-data-badge"><i class="bi bi-database-check"></i><c:out value="${page.totalItems}"/> tin trong hệ thống</span></div><div class="main-content"><jsp:include page="/WEB-INF/views/common/flash.jsp"/><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if>
<section class="card mb-4"><div class="card-body"><form class="row g-3 align-items-end" action="${pageContext.request.contextPath}/admin/jobs" method="get"><div class="col-lg-5"><label class="form-label" for="adminJobKeyword">Tìm kiếm</label><input class="form-control" id="adminJobKeyword" name="keyword" maxlength="150" value="<c:out value='${param.keyword}'/>" placeholder="Mã tin, vị trí hoặc công ty"></div><div class="col-lg-3"><label class="form-label" for="adminJobStatus">Trạng thái</label><select class="form-select" id="adminJobStatus" name="status"><option value="">Tất cả</option><option value="DRAFT" ${param.status eq 'DRAFT' ? 'selected' : ''}>Bản nháp</option><option value="PUBLISHED" ${param.status eq 'PUBLISHED' ? 'selected' : ''}>Đang tuyển</option><option value="CLOSED" ${param.status eq 'CLOSED' ? 'selected' : ''}>Đã đóng</option><option value="ARCHIVED" ${param.status eq 'ARCHIVED' ? 'selected' : ''}>Lưu trữ</option></select></div><div class="col-lg-4 d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="bi bi-search me-1"></i>Lọc dữ liệu</button><a class="btn btn-light" href="${pageContext.request.contextPath}/admin/jobs">Xóa lọc</a></div></form></div></section>
<section class="card"><div class="card-header bg-white border-0 px-4 pt-4"><h2 class="h5 mb-1">Toàn bộ tin tuyển dụng</h2><p class="small text-muted mb-0">Theo dõi chủ sở hữu, hạn nhận hồ sơ và lượng ứng viên từ một nơi.</p></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th class="ps-4">Tin tuyển dụng</th><th>Doanh nghiệp</th><th>Hạn nộp</th><th>Hồ sơ</th><th>Trạng thái</th><th class="text-end pe-4">Thao tác</th></tr></thead><tbody><c:forEach var="job" items="${jobs}"><tr><td class="ps-4"><strong><c:out value="${job.title}"/></strong><small class="d-block text-muted"><c:out value="${job.jobCode}"/> · <c:out value="${job.location}"/></small></td><td><c:out value="${empty job.companyName ? 'Chưa hoàn thiện hồ sơ' : job.companyName}"/></td><td><fmt:formatDate value="${job.deadline}" pattern="dd/MM/yyyy"/></td><td><a href="${pageContext.request.contextPath}/admin/applications?keyword=${job.jobCode}"><strong><c:out value="${applicationCounts[job.id]}" default="0"/></strong> hồ sơ</a></td><td><span class="status-badge status-${job.status}"><c:out value="${job.status}"/></span></td><td class="text-end pe-4"><div class="btn-group"><c:if test="${job.status eq 'PUBLISHED'}"><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/jobs/detail?id=${job.id}"><i class="bi bi-eye"></i></a></c:if><a class="btn btn-sm btn-outline-secondary" href="${pageContext.request.contextPath}/hr/jobs/edit?id=${job.id}"><i class="bi bi-pencil"></i></a></div></td></tr></c:forEach><c:if test="${empty jobs}"><tr><td colspan="6"><div class="empty-state py-5"><div class="empty-icon"><i class="bi bi-briefcase"></i></div><h2 class="h5">Không có tin phù hợp</h2><p>Thử thay đổi bộ lọc để xem dữ liệu khác.</p></div></td></tr></c:if></tbody></table></div><jsp:include page="/WEB-INF/views/common/pagination.jsp"/></section>
</div></main></div><jsp:include page="/WEB-INF/views/common/footer.jsp"/>
